# Configuración de Google Gemini para Red Salud Andina (RSA)

# 1. Endpoint Personalizado (Custom URL / Sub2API / Proxy)
CUSTOM_GEMINI_BASE_URL="http://192.168.1.38:8080/antigravity"
CUSTOM_GEMINI_API_KEY="sk-your-custom-api-key"

# 2. Endpoint Oficial de Google Gemini
# Obtén tu clave en https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="your_gemini_api_key_here"

# Modelo y Puerto
GEMINI_MODEL="gemini-3.8-flash"
PORT=3000
