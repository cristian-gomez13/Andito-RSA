# Configuración de Google Gemini para Red Salud Andina (RSA)
# Obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini recomendado (ej: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Puerto del servidor Bun (por defecto 3000)
PORT=3000
